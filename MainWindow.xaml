<Window x:Class="LinGuGu2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:uc="clr-namespace:LinGuGu2.UserControls"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        Loaded="Window_Loaded"
        Height="630" Width="1050"
        Background="Transparent"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolTovis" />
    </Window.Resources>

    <!--background-->
    <Border CornerRadius="12 12 12 12" Background="#f8f7fc"
            Margin="0 0 0 0"
            MouseDown="Border_MouseDown">
        <!-- MouseLeftButtonDown="Border_MouseLeftButtonDown" -->
        <!-- 窗口三个按钮关闭，最大化，最小化 -->
        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="330" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="70" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" Margin="0 0 8 0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                <Button Style="{StaticResource TextBoxButton}" Margin="0 0 1 0"
                        Click="MinimizeButtonClick">
                    <icon:PackIconMaterial Kind="WindowMinimize" Width="12" Foreground="#a6a6a6" />
                </Button>

                <Button Style="{StaticResource TextBoxButton}"
                        Click="MaximizeButtonClick">
                    <icon:PackIconMaterial Kind="WindowMaximize" Width="12" Foreground="#a6a6a6" />
                </Button>

                <Button Style="{StaticResource TextBoxButton}"
                        Click="CloseButtonClick">
                    <icon:PackIconMaterial Kind="Close" Width="12" Foreground="#a6a6a6" />
                </Button>
            </StackPanel>

            <!--left menu 1-->
            <Border Grid.Column="0" Grid.Row="0" CornerRadius="12" Grid.RowSpan="2" Panel.ZIndex="2"
                    Background="#6145e3">
                <Grid>
                    <!--App tittle-->
                    <TextBlock Text="Udp Chat App" Foreground="#FFFFFF" FontSize="16" VerticalAlignment="Top"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold" Margin="0 30 0 0">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Grid>
            </Border>
            <!-- left menu 2 -->
            <Border Visibility="Collapsed"
                    Grid.Column="1" Grid.RowSpan="2" CornerRadius="0 20 20 0" Background="#6f50ff" Panel.ZIndex="1"
                    Margin="-25 0 0 0">
                <Grid>
                    <!--top combobox-->
                    <ComboBox Style="{DynamicResource ComboBoxStyle1}" VerticalAlignment="Top" Margin="25 45 0 0">
                        <ComboBoxItem Content="Cabang Yog" />
                        <ComboBoxItem Content="Reza Asadi" IsSelected="True" />
                        <ComboBoxItem Content="John Doe" />
                        <ComboBoxItem Content="Rojan Mary" />
                    </ComboBox>

                    <!--menu buttons-->
                    <StackPanel Margin="25 160 0 0">
                        <uc:MenuButton Title="Dashboard" Icon="HomeOutline" />
                        <uc:MenuButton Title="Shipment" Icon="ChartTimelineVariantShimmer" />
                        <uc:MenuButton Title="Users" Icon="AccountMultipleOutline" />
                        <uc:MenuButton Title="Messages" Icon="MessageOutline" IsActive="True" />
                        <uc:MenuButton Title="Revenue" Icon="CurrencyUsd" />
                        <uc:MenuButton Title="Maps" Icon="MapMarkerOutline" />
                    </StackPanel>

                    <!--menu buttons bottom-->
                    <StackPanel Margin="25 0 0 40" VerticalAlignment="Bottom">
                        <uc:MenuButton Title="Settings" Icon="CogOutline" />
                        <uc:MenuButton Title="Logout" Icon="Logout" />
                    </StackPanel>
                </Grid>
            </Border>
            <!--chat items section-->
            <Border Grid.Column="1" Grid.Row="1">
                <Grid>
                    <!--separator-->
                    <StackPanel Orientation="Horizontal" Margin="30 0 0 30">
                        <Rectangle Width="0.8" Stroke="#dadada" VerticalAlignment="Stretch" />
                    </StackPanel>

                    <!--group items-->
                    <StackPanel
                        Margin="30 0 15 0">
                        <TextBlock Text="Persons" Margin="25 15 0 5" Style="{StaticResource TitleText}" />

                        <ListView Name="UserListView"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  BorderBrush="Transparent"
                                  Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <uc:Item Title="{Binding Name}"
                                             IsActive="{Binding IsChatWith}"
                                             Image="/Images/p3.jpg"
                                             Color="{Binding Color}"
                                             MessageCount="{Binding MessageCount}"
                                             MouseLeftButtonDown="UserItemLeftClick">
                                        <!-- 添加菜单 -->
                                        <uc:Item.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="清除聊天记录" Click="ClearChat_Click" />
                                                <MenuItem Header="删除好友" Click="DeleteUser_Click" />
                                            </ContextMenu>
                                        </uc:Item.ContextMenu>
                                    </uc:Item>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button
                            Command="{Binding DisableOtherButtonsCommand}"
                            x:Name="SHowAllButton"
                            Content="Show All" Style="{StaticResource ShowBoxButton}" />

                    </StackPanel>
                </Grid>
            </Border>
            <!-- chat section 3 -->
            <Border
                Grid.Column="3" Grid.Row="1"
                CornerRadius="15" Background="#ffffff"
                Margin="0 0 30 30"
                ClipToBounds="True">
                <Border x:Name="ChatPanel" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>

                        <!--Top chat menubar-->
                        <Grid
                            Background="#ffffff">
                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="1" Direction="-90" Opacity="0.1" />
                            </Grid.Effect>

                            <TextBlock x:Name="ChatUserName"
                                       Text="MoonLab Std" FontSize="16" Margin="20 15" HorizontalAlignment="Left" />
                        </Grid>


                        <!--聊天界面-->
                        <ScrollViewer Style="{StaticResource ScrollViewerStyle}"
                                      x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="ChatStackPanel" Margin="20 10 20 20">
                            </StackPanel>
                        </ScrollViewer>

                        <!--底部 聊天 框-->
                        <Grid Grid.Row="2" Margin="10 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <!--message textBox-->
                            <Grid>
                                <TextBlock Margin="15 0 120 0" VerticalAlignment="Center"
                                           Foreground="#868686" Panel.ZIndex="1"
                                           IsHitTestVisible="False" Text="请输入消息发送"
                                           Visibility="{Binding ElementName=TxtMessage,Path=Text.IsEmpty,Converter={StaticResource BoolTovis}}" />
                                <TextBox IsEnabled="{Binding TxtMessageViewModel.IsEnable}"
                                         Text="{Binding TextBoxText,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
                                         x:Name="TxtMessage" Style="{StaticResource MessageTextBox}">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter"
                                                    Command="{Binding SendMessageCommand}"
                                                    CommandParameter="{Binding ElementName=TxtMessage,Path=Text}">
                                        </KeyBinding>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>
                            <!--发送按钮-->
                            <Button x:Name="SendButton" IsEnabled="{Binding SendButtonViewModel.IsEnable}"
                                    Grid.Column="1" Margin="5 0 0 0" Style="{StaticResource TextBoxButton}"
                                    Command="{Binding SendMessageCommand}"
                                    CommandParameter="{Binding ElementName=TxtMessage,Path=Text}">
                                <icon:PackIconMaterial Kind="Send" Margin="3 0 0 2" Width="16" Foreground="#6f59d4">
                                    <icon:PackIconMaterial.LayoutTransform>
                                        <RotateTransform Angle="-45" />
                                    </icon:PackIconMaterial.LayoutTransform>
                                </icon:PackIconMaterial>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>